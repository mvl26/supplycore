# SupplyCore deployment config — copy to .env and edit.
#   cp .env.example .env

# --- Image (GitHub Container Registry) ---
IMAGE=ghcr.io/mvl26/supplycore
IMAGE_TAG=latest
# always | missing | never  — use "missing" to avoid re-pulling on every up
PULL_POLICY=missing

# --- Site ---
# The site name doubles as the Host header nginx routes on.
# For LAN/quickstart use a *.localhost name. For a real domain, set it to the domain.
SITE_NAME=supplycore.localhost

# --- Credentials (CHANGE THESE) ---
ADMIN_PASSWORD=changeme-admin
DB_PASSWORD=changeme-db

# --- Networking ---
# Host port that maps to the nginx frontend (container :8080).
HTTP_PORT=8080
