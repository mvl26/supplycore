{
 "actions": [], "creation": "2026-05-07 00:00:00", "doctype": "DocType", "engine": "InnoDB",
 "autoname": "format:SC-AR-{#####}", "track_changes": 1,
 "field_order": [
  "section_main", "title", "alert_type", "severity",
  "column_break_1", "enabled", "frequency", "scheduled_time", "day_of_week",
  "section_threshold", "threshold_value", "threshold_operator", "threshold_unit",
  "section_channels", "channel_email", "channel_inapp", "channel_sms",
  "column_break_channels", "sms_phones",
  "section_recipients", "recipient_roles", "extra_emails",
  "section_test", "last_test_at", "last_test_status", "last_test_error",
  "section_meta", "description", "last_triggered_at", "last_alert_count"
 ],
 "fields": [
  {"fieldname": "section_main", "fieldtype": "Section Break", "label": "Quy tắc cảnh báo"},
  {"fieldname": "title", "fieldtype": "Data", "label": "Tiêu đề", "reqd": 1, "in_list_view": 1, "search_index": 1},
  {"fieldname": "alert_type", "fieldtype": "Select",
   "options": "low_stock\nexpiring_batch\ncontract_expiring\nfc_remaining_low\noverdue_payment\nqc_pending\nrecall_outstanding",
   "label": "Loại cảnh báo", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "severity", "fieldtype": "Select",
   "options": "Critical\nWarning\nInfo",
   "label": "Mức độ", "default": "Warning", "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "column_break_1", "fieldtype": "Column Break"},
  {"fieldname": "enabled", "fieldtype": "Check", "label": "Đang sử dụng", "default": "1", "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "frequency", "fieldtype": "Select",
   "options": "Daily\nHourly\nRealtime\nWeekly",
   "label": "Tần suất quét", "default": "Daily", "in_list_view": 1},
  {"fieldname": "scheduled_time", "fieldtype": "Time", "label": "Giờ chạy (Daily/Weekly)", "default": "08:00:00",
   "description": "Ví dụ 08:00 cho Daily 8AM. Realtime/Hourly bỏ qua field này."},
  {"fieldname": "day_of_week", "fieldtype": "Select",
   "options": "\nMon\nTue\nWed\nThu\nFri\nSat\nSun",
   "label": "Thứ trong tuần (Weekly)", "depends_on": "eval:doc.frequency=='Weekly'", "default": "Mon"},

  {"fieldname": "section_threshold", "fieldtype": "Section Break", "label": "Ngưỡng"},
  {"fieldname": "threshold_value", "fieldtype": "Float", "label": "Giá trị ngưỡng", "default": "30",
   "description": "VD: 30 ngày cho expiring_batch / contract_expiring"},
  {"fieldname": "threshold_operator", "fieldtype": "Select",
   "options": "<\n<=\n=\n>=\n>",
   "label": "Phép so sánh", "default": "<="},
  {"fieldname": "threshold_unit", "fieldtype": "Select",
   "options": "\ndays\npercent\nVND\nqty",
   "label": "Đơn vị", "default": "days"},

  {"fieldname": "section_channels", "fieldtype": "Section Break", "label": "Kênh gửi cảnh báo"},
  {"fieldname": "channel_email", "fieldtype": "Check", "label": "Email", "default": "1",
   "description": "Gửi qua Frappe Email Queue (auto-retry on failure)"},
  {"fieldname": "channel_inapp", "fieldtype": "Check", "label": "In-app notification", "default": "1",
   "description": "Tạo SC Alert in Alert Center"},
  {"fieldname": "channel_sms", "fieldtype": "Check", "label": "SMS", "default": "0",
   "description": "Cần cấu hình sms_gateway_endpoint trong SupplyCore Settings"},
  {"fieldname": "column_break_channels", "fieldtype": "Column Break"},
  {"fieldname": "sms_phones", "fieldtype": "Small Text", "label": "Số điện thoại SMS",
   "depends_on": "channel_sms",
   "description": "Phân cách dấu phẩy. Bắt buộc khi channel_sms=1"},

  {"fieldname": "section_recipients", "fieldtype": "Section Break", "label": "Người nhận (Email/In-app)"},
  {"fieldname": "recipient_roles", "fieldtype": "Small Text", "label": "Roles nhận",
   "description": "Phân cách dấu phẩy. VD: SupplyCore Manager,SupplyCore Storekeeper"},
  {"fieldname": "extra_emails", "fieldtype": "Small Text", "label": "Email bổ sung",
   "description": "Email cụ thể, phân cách dấu phẩy"},

  {"fieldname": "section_test", "fieldtype": "Section Break", "label": "Kết quả test gần nhất", "collapsible": 1},
  {"fieldname": "last_test_at", "fieldtype": "Datetime", "label": "Thời điểm test", "read_only": 1},
  {"fieldname": "last_test_status", "fieldtype": "Select",
   "options": "\nSuccess\nFailed\nPartial",
   "label": "Status test", "read_only": 1},
  {"fieldname": "last_test_error", "fieldtype": "Small Text", "label": "Lỗi (nếu fail)", "read_only": 1},

  {"fieldname": "section_meta", "fieldtype": "Section Break", "collapsible": 1},
  {"fieldname": "description", "fieldtype": "Small Text", "label": "Mô tả"},
  {"fieldname": "last_triggered_at", "fieldtype": "Datetime", "label": "Lần fire gần nhất", "read_only": 1},
  {"fieldname": "last_alert_count", "fieldtype": "Int", "label": "Số alert gần nhất", "read_only": 1, "default": "0"}
 ],
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1},
  {"role": "SupplyCore Manager", "read": 1, "write": 1, "create": 1, "report": 1}
 ],
 "owner": "Administrator", "modified_by": "Administrator", "modified": "2026-05-07 00:00:00",
 "module": "M11 Dashboard", "name": "SC Alert Rule",
 "title_field": "title",
 "sort_field": "modified", "sort_order": "DESC"
}
