 "fields": [
  {"fieldname": "section_main", "fieldtype": "Section Break", "label": "Thông tin chung"},
  {"fieldname": "supplier", "fieldtype": "Link", "options": "SC Supplier", "label": "Nhà cung cấp", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "search_index": 1},
  {"fieldname": "supplier_name", "fieldtype": "Data", "label": "Tên NCC", "fetch_from": "supplier.supplier_name", "read_only": 1},
  {"fieldname": "contract_number", "fieldtype": "Data", "label": "Số hợp đồng", "reqd": 1, "unique": 1, "in_list_view": 1},
  {"fieldname": "column_break_1", "fieldtype": "Column Break"},
  {"fieldname": "contract_date", "fieldtype": "Date", "label": "Ngày ký", "reqd": 1, "default": "Today"},
  {"fieldname": "valid_from", "fieldtype": "Date", "label": "Hiệu lực từ", "reqd": 1},
  {"fieldname": "valid_to", "fieldtype": "Date", "label": "Hết hạn", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1, "search_index": 1},

  {"fieldname": "section_value", "fieldtype": "Section Break", "label": "Giá trị hợp đồng"},
  {"fieldname": "total_value", "fieldtype": "Currency", "label": "Tổng giá trị (VND)", "read_only": 1, "in_list_view": 1, "options": "VND", "non_negative": 1, "description": "Tự động tính = Σ thành tiền các dòng vật tư bên dưới"},
  {"fieldname": "used_value", "fieldtype": "Currency", "label": "Đã sử dụng (PO submitted)", "read_only": 1, "default": "0", "options": "VND", "no_copy": 1, "in_list_view": 1, "description": "Tổng grand_total các PO đã submit"},
  {"fieldname": "committed_value", "fieldtype": "Currency", "label": "Đang gọi (RO Approved)", "read_only": 1, "default": "0", "options": "VND", "no_copy": 1, "description": "Tổng RO đã duyệt nhưng chưa convert sang PO"},
  {"fieldname": "remaining_value", "fieldtype": "Currency", "label": "Còn lại khả dụng", "read_only": 1, "options": "VND", "no_copy": 1, "in_list_view": 1, "description": "= Tổng giá trị − Đã sử dụng − Đang gọi"},
  {"fieldname": "column_break_2", "fieldtype": "Column Break"},
  {"fieldname": "payment_terms", "fieldtype": "Data", "label": "Điều khoản thanh toán", "description": "VD: Net 30, COD"},
  {"fieldname": "delivery_terms", "fieldtype": "Small Text", "label": "Điều khoản giao hàng",
   "description": "VD: Giao tận kho/lead time 7 ngày/free shipping"},

  {"fieldname": "section_items", "fieldtype": "Section Break", "label": "Danh mục vật tư trong hợp đồng"},
  {"fieldname": "items", "fieldtype": "Table", "options": "FC Item", "label": "Danh mục vật tư", "reqd": 1},

  {"fieldname": "section_approval", "fieldtype": "Section Break",
   "label": "Phê duyệt 3-tier (Kế toán → Quản lý → Lãnh đạo)"},
  {"fieldname": "approval_stage", "fieldtype": "Select",
   "options": "Draft\nManager Review\nExecutive Review\nApproved\nRejected",
