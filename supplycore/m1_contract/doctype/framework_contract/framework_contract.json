  {"fieldname": "manager_approved_by", "fieldtype": "Link", "options": "User",
   "label": "Quản lý duyệt", "read_only": 1},
  {"fieldname": "manager_approved_at", "fieldtype": "Datetime",
   "label": "Thời điểm Manager duyệt", "read_only": 1},
  {"fieldname": "manager_comment", "fieldtype": "Small Text", "label": "Ghi chú Quản lý"},
  {"fieldname": "column_break_approval", "fieldtype": "Column Break"},
  {"fieldname": "executive_approved_by", "fieldtype": "Link", "options": "User",
   "label": "Lãnh đạo duyệt", "read_only": 1},
  {"fieldname": "executive_approved_at", "fieldtype": "Datetime",
   "label": "Thời điểm Executive duyệt", "read_only": 1},
  {"fieldname": "executive_comment", "fieldtype": "Small Text", "label": "Ghi chú Lãnh đạo"},
  {"fieldname": "executive_override_blacklist", "fieldtype": "Check",
   "label": "Lãnh đạo xác nhận override blacklist", "default": "0",
   "description": "Bật khi NCC trong blacklist nhưng Lãnh đạo cho phép HĐ này"},
  {"fieldname": "rejection_reason", "fieldtype": "Small Text",
   "label": "Lý do từ chối", "read_only": 1, "depends_on": "eval:doc.approval_stage=='Rejected'"},

  {"fieldname": "section_status", "fieldtype": "Section Break", "label": "Trạng thái"},
  {"fieldname": "status", "fieldtype": "Select", "options": "Draft\nActive\nExpired\nExhausted\nTerminated", "label": "Trạng thái", "default": "Draft", "in_list_view": 1, "in_standard_filter": 1, "read_only": 1, "search_index": 1},
  {"fieldname": "column_break_3", "fieldtype": "Column Break"},
  {"fieldname": "expiring_soon", "fieldtype": "Check", "label": "Sắp hết hạn (≤30 ngày)", "read_only": 1, "no_copy": 1, "default": "0"},

  {"fieldname": "section_renewal", "fieldtype": "Section Break",
   "label": "Lịch sử gia hạn", "collapsible": 1},
  {"fieldname": "renewal_history", "fieldtype": "Table", "options": "FC Renewal History",
   "label": "Lịch sử gia hạn",
   "description": "Mỗi lần gia hạn (extend valid_to) ghi 1 row + workflow Manager duyệt"},

  {"fieldname": "section_termination", "fieldtype": "Section Break",
   "label": "Thanh lý hợp đồng", "collapsible": 1, "depends_on": "eval:doc.status=='Terminated' || doc.termination_date"},
  {"fieldname": "termination_date", "fieldtype": "Date", "label": "Ngày thanh lý", "read_only": 1},
  {"fieldname": "termination_reason", "fieldtype": "Small Text", "label": "Lý do thanh lý", "read_only": 1},
  {"fieldname": "termination_minutes", "fieldtype": "Attach", "label": "Biên bản thanh lý (PDF)", "read_only": 1},

  {"fieldname": "section_other", "fieldtype": "Section Break", "label": "Khác", "collapsible": 1},
  {"fieldname": "attachment", "fieldtype": "Attach", "label": "File hợp đồng (PDF)"},
  {"fieldname": "attachments", "fieldtype": "Long Text", "label": "Tài liệu đính kèm (nhiều tệp)", "description": "JSON [{url,name}] — quản lý qua form SPA"},
  {"fieldname": "remarks", "fieldtype": "Small Text", "label": "Ghi chú"},
  {"fieldname": "amended_from", "fieldtype": "Link", "options": "Framework Contract", "label": "Amended From", "no_copy": 1, "print_hide": 1, "read_only": 1}
